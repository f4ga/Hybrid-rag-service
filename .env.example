# Пример файла переменных окружения
# Скопируйте этот файл в .env и измените значения на свои

# Параметры подключения к базе данных PostgreSQL
DB_USER=your_username_here
DB_PASSWORD=your_password_here
DB_HOST=your_host_here
DB_PORT=your_port_here
DB_NAME=your_db_name_here

# Параметры сервера
SERVER_HOST=your_host_here
SERVER_PORT=your_port_here
SERVER_RELOAD=your_reload_setting_here

# Уровень логирования
LOG_LEVEL=INFO